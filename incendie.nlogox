<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.2" snapToGrid="true">
  <code><![CDATA[globals [
  vitesse-urgence-pompier
  urgence-base?
]
breed [ pompiers pompier]
breed [ gardes garde ]
breed [ pyromanes pyromane ]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

patches-own [
  est-foret? ; true si le patch est foret, false sinon
  est-terre? ; true si le patch est terre, false sinon
  est-base? ; true si le patch est la base des pompiers, false sinon
  en-feu? ; true si le patch est en train de bruler, false sinon
  est-crame? ; true si le patch est cramé , false sinon
  en-pousse? ; true si le patch est en train de pousser, false sinon
  taille ; la taille actuelle du patch (0 si il est cramé, taille-max si il est complètement poussé)
  cpt-repousse ; compteur de temps actuel de repousse
  odeur-pyro ; la quantité d'odeur déposée pas les pyromanes
  taille-base ; taille de la base
  etat-base ; état de la base (indemne, endommagée ou détruite)
  durabilite-base ; durabilité de la base face au feu
]

pompiers-own [
  eau-restante ; la quantité d'eau restante du pompier
  etat; l'état en cours du pompier ("en-patrouille", "en-extinction", "en-ravitaillement")
  vitesse ; la vitesse du pompier
]

gardes-own [
  etat ; l'état en cours du garde ("en-patrouille", "en-poursuite", "en-suivi-odeur", "arrestation")
  vitesse ; la vitesse du garde
]

pyromanes-own [
  etat ; l'état en cours du pyromane ("en-fuite", "en-pyromanie", "capture")
  vitesse ; la vitesse du pyromane
  mon-garde ; le garde qui capture le pyroname
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; procédure qui initialise les variables au début du setup
to initialisation-variables-patches
  set est-foret? false
  set est-terre? false
  set est-base? false
  set en-feu? false
  set est-crame? false
  set en-pousse? false
  set taille 0
  set cpt-repousse temps-repousse-crame
  set odeur-pyro 0
  set taille-base 10
  set durabilite-base 0
end


;;; procédure qui met à jour la couleur d'un patch en fonction de son état
to set-color-patches
  if est-terre? [set pcolor brown] ; marron pour la terre
  if est-foret? [set pcolor green - 2] ; vert foncé pour la forêt
  if est-base? [set pcolor blue] ; bleu pour la base
end


;;; procédure qui place une troupe (pompier/garde) aléatoirement dans la base
to placer-troupe-dans-la-base [la-troupe]
  let p one-of patches with [est-base?]  ; choisit aléatoirement un patch de la base (est-base? = true)
  ask la-troupe [ ; le place sur le patch choisi
    move-to p
  ]
end


;;; procédure qui place un pyromane aléatoirement hors de la base
to placer-pyromane-hors-de-la-base [le-pyromane]
  let p one-of patches with [not est-base?] ; choisit aléatoirement un patch hors de la base (est-base? = false)
  ask le-pyromane [ ; le place sur le patch choisi
    move-to p
  ]
end


;;; procédure qui fait agir les pompiers
to go-pompiers
  ask pompiers [
    
    let a-eteindre nobody
    if urgence-base? [
      set vitesse vitesse-urgence-pompier
      set etat "en-urgence"
      set a-eteindre min-one-of patches with [est-base? and en-feu? and not est-crame?] [distance myself]
      if a-eteindre = nobody [
        let base min-one-of patches with [est-base?] [distance myself]
      ]
    ]
    if not urgence-base? [
      set vitesse 3
    ]
    ; si réserve non vide : cherche un patch de feu à éteindre
    if etat != "en-urgence" and eau-restante > 0 [
      ; vérification si il y a du feu à éteindre
      set a-eteindre min-one-of patches with [en-feu? and not est-crame?] [distance myself]
    ]
    ; état de patrouille (par défaut)
    set etat "en-patrouille"

    ; si un feu est dispo à éteindre : état d'extinction
    if a-eteindre != nobody [
      set etat "en-extinction"
    ]
    
    ; si la réserve est vide
    if eau-restante <= 0 [
      set etat "en-ravitaillement"
    ]
      
    ; si état de ravitaillement, se ravitaille
    if etat = "en-ravitaillement" [
      ravitaillement
    ]

    ; si état d'extinction de feu
    if etat = "en-extinction" or etat = "en-urgence" [
      
      ; calcule la distance entre le pompier et le feu
      let distance-feu distance a-eteindre
      
      ; si elle est trop longue, s'en rapproche
      ifelse distance-feu > 2 [
        face a-eteindre
        fd vitesse
      ] [         
        ; sinon il éteint le feu  
        face a-eteindre
        eteindre
        ]
    ]
    ; si il est en état de patrouille : se déplace aléatoirement
    if etat = "en-patrouille" [
      rt random 50 - random 50
      fd vitesse
    ]
  ]
end


;;; procédure d'un pompier pour se ravitailler
to ravitaillement
  
  ; cherche le patch de base le plus proche
  let base min-one-of patches with [est-base? and durabilite-base > 0] [ 
    distance myself 
  ]
      
  ; si il n'y est pas, s'y dirige
  if not [est-base?] of patch-here [
    face base      
    fd vitesse
  ]
      
  ; sinon il se ravitaille, et passe en état patrouille
  if [est-base? and durabilite-base > 0] of patch-here [
    set eau-restante reserve-max-pompier
    set etat "en-patrouille"
  ]
end


;;; procédure d'un pompier pour éteindre le feu
to eteindre
  let nb-extinctions 0 ; nombre de patches de feu éteints
  
  ; pour tous les patches à max 2 de distance en face du pompier, avec un angle de 150 degrés
  ask patches in-radius 2 [
    
    ; si il est en feu, l'éteindre
    if en-feu? [
      set en-feu? false
      set pcolor blue ; couleur bleu pour simuler le jet d'eau
      set cpt-repousse temps-repousse-crame ; démarre le compteur de repousse
      set nb-extinctions nb-extinctions + 1 ; incrémente le nombre de patches éteints
      if not est-base? [
        set est-crame? true
      ]
    ]
  ]
  set eau-restante eau-restante - nb-extinctions ; maj de la réserve
end


;;; procédure qui fait agir les pyromanes
to go-pyromanes
  ask pyromanes [
    ; suis le garde qui l'a capturé
    ifelse etat = "capture" [
      if mon-garde != nobody [
      move-to mon-garde
      set color orange
      ]
      ; meurt quand il arrive à la base
      if [est-base?] of patch-here [
        die
      ]
    ][
    ; esquive du feu
    let danger min-one-of patches in-radius 5 with [est-base? or en-feu?] [distance myself]
    if danger != nobody [
      face danger
      rt 180
      fd vitesse
    ]
    ; dépose de l'odeur sur son patch
    ask patch-here [
        set odeur-pyro 100
    ]
    
    ; détecte le garde le plus proche dans son rayon de détection, et le prend comme menace (nobody sinon)
    let menace min-one-of gardes in-radius rayon-fuite-pyromanes [
      distance myself
    ]
    
    ; si il y a une menace : état de fuite
    ifelse menace != nobody [
      set etat "en-fuite"
      face menace
      rt 180
      fd vitesse
    ] [
      ; sinon : état de pyromanie
      set etat "en-pyromanie"
      
      ; déplacement aléatoire
      rt random 50 - random 50
      fd vitesse
      
      ; met le feu avec une certaine chance à son patch
      ask patch-ahead 1 [  
        if (est-foret? and not en-feu? and not est-crame? and not en-pousse? and not est-base?) [
          if random 100 < 2 [
            set en-feu? true
            set en-pousse? false
          ]
        ]
      ]
    ]
    ]
    ; meurt s'il touche le feu
    mort-feu
  ]
end


;;; procédure qui fait agir les gardes
to go-gardes
  ask gardes [
    
    ; le garde repère sa distance par rapport à la base
    let base min-one-of patches with [est-base?] [distance myself]
    ; ramène le pyromane capturé à la base
    ifelse etat = "arrestation" [
      ifelse not [est-base?] of patch-here [
        face base
        fd vitesse
      ][
        set etat "en-patrouille"
      ]
    ] [
    ; esquive du feu
    let danger min-one-of patches in-radius 5 with [en-feu?] [distance myself]
    if danger != nobody [
      face danger
      rt 180
      fd vitesse
    ]
    ; détecte le pyromane le plus proche dans son rayon de détection, et le prend comme cible (nobody sinon) 
      let cible min-one-of pyromanes with [mon-garde = nobody] in-radius rayon-detection-gardes [
      distance myself
    ]
    
    ; si il y a une cible, état de poursuite
    ifelse cible != nobody [
      set etat "en-poursuite"
      face cible 
      fd vitesse
    ]
    [
      ; sinon recherche l'odeur la plus forte
      let trace max-one-of neighbors [odeur-pyro]
      let seuil-detection 1.0
      
      ; si il y a une odeur assez forte : état de suivi d'odeur
      ifelse [odeur-pyro] of trace > seuil-detection [
        set etat "en-suivi-odeur"
        face trace
        fd vitesse
      ] 
      [
        ; sinon état de patrouille : déplacements aléatoires
        set etat "en-patrouille"
        rt random 50 - random 50
        fd vitesse
      ]
    ]

    ; si un pyromane est assez proche : il est attrapé
      let pyromane-proche one-of pyromanes-here with [mon-garde = nobody]
    if pyromane-proche != nobody [
      ask pyromane-proche [ set etat "capture" set mon-garde myself ]
      set etat "arrestation"
    ]
    ]
    ; meurt s'il touche le feu
    mort-feu
  ]
end


;;; procédure de mort en contact du feu
to mort-feu
  if [en-feu?] of patch-here [die]
end


;;; procédure qui fait se propager la forêt sur la terre
to propagation-foret
  ask patches with [est-foret? and not est-crame? and not en-pousse? and not est-base?] [ ; pour tous les patches de forêt ni en pousse, ni cramés, ni bases
    ask neighbors with [est-terre?] [ ; pour tous leurs voisins qui sont terre
      if random 100 < vitesse-propagation-foret [ ; pourcentage de chance de se propager dessus
        set est-terre? false 
        set est-foret? true
        set en-pousse? true
        set taille 0
        set pcolor (green + 2) ; couleur vert foncé
      ]
    ]
  ]
end


;;; procédure qui fait grandir les patches de forêt en état de pousse 
to pousse-foret
  ask patches with [est-foret? and en-pousse?] [ ; pour tous les patches de forêt en pousse
    set taille taille + 1 ; incrémente la taille
    
    ; dégradé de couleur du vert clair au foncé en fonction de la taille
    let t (taille / taille-max) 
    set pcolor green - (t * 2)
    
    ; si la taille max est atteinte
    if taille >= taille-max [
      set en-pousse? false ; arrêt de la pousse
      set taille taille-max ; remet la taille au maximum en cas de dépassement
      set pcolor (green - 2) ; couleur forêt 
    ]
  ]
end


;;; procédure qui fait repousser les patches de forêt cramés
to repousse-crame
  ask patches with [est-crame?] [
    set cpt-repousse cpt-repousse - 1 ; décrémente le compteur de repousse
    
    ; si le compteur est terminé : le patch redevient forêt en pousse de taille 0
      if (cpt-repousse <= 0) [
        set est-crame? false
        set est-foret? true
        set en-pousse? true
        set taille 0
      ]
    ]
end


;;; procédure qui fait se propager le feu
to propagation-feu
  ask patches with [en-feu? and not est-crame?] [ ; pour tous les patches en feu non cramés 
    if est-base? [
      set durabilite-base durabilite-base - 1
      if durabilite-base < 0 [
          set durabilite-base 0
        ]
      ]
    ask neighbors with [(est-foret? or est-base?) and not en-feu? and not est-crame? and not en-pousse?] [ ; pour tous leurs voisins qui sont forêt de taille max, pas encore en feu, ni cramés
        if random 100 < vitesse-propagation-feu [ ; pourcentage de chance de se propager dessus
          set en-pousse? false 
          set en-feu? true
          set pcolor red ; le patch devient rouge  
      ]
    ]
    if not est-base? [
    ; réduction progressive de la taille
    set taille taille - 0.5
    
    ; si la taille min est atteinte
    if taille <= 0 [ 
      set taille 0 ; remet la taille à 0 en cas de dépassement
      set en-feu? false 
      set est-crame? true 
    ]
    
    ; si le patch est en feu
    if en-feu? [ 
      ; dégradé de couleur du rouge clair au foncé en fonction de la taille
      let t 1 - (taille / taille-max) 
      set pcolor red - (t * 4) 
    ] 
    
    ; si le patch est cramé : couleur noire
    if est-crame? [
      set pcolor black
      set cpt-repousse temps-repousse-crame
    ] 
    ]
  ]
end


;;; procédure qui met à jour l'état de la base
to gestion-base
  ask patches with [est-base?] [
    
    let pourcentage-base durabilite-base / durabilite-base-max
    ifelse durabilite-base <= 0 [
      set etat-base "détruite"
      set pcolor black
    ] [
      ifelse pourcentage-base >= 0.76 [
        set etat-base "indemne"
        set pcolor blue
      ] [
        ifelse pourcentage-base >= 0.26 [
          set etat-base "endommagée"
          set pcolor violet
        ] [
          set etat-base "critique"
          set pcolor red
        ]
      ]
    ]
  ]
end


;;; procédure qui diffuse et fait s'évaporer l'odeur des pyromanes 
to gestion-odeur
  diffuse odeur-pyro 0.2 ; diffusion de l'odeur sur les patches voisins
  ask patches [
    set odeur-pyro odeur-pyro - 5 ; évaporation de l'odeur progressive
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  ask patches [
    
    ; 1) initialisation des variables des patches
    initialisation-variables-patches 
 
    ; 2) création de la base
    if (pxcor >= (0 - taille-base / 2) and pxcor < (0 + taille-base / 2) and pycor >= (0 - taille-base / 2) and pycor < (0 + taille-base / 2)) [
      set est-base? true 
      set etat-base "indemne"
      set durabilite-base durabilite-base-max
    ]
    
    ; 3) sinon il est aléatoirement forêt ou terre avec un pourcentage choisi
    if not est-base? [
      ifelse random 100 < pourcentage-foret [
        set est-foret? true
        set taille taille-max 
      ] [
        set est-terre? true
      ]
    ]
   
    ; 4) mise à jour de la couleur des patchs en fonction de leur type
    set-color-patches
  ]
  ; pour l'état d'urgence
  set urgence-base? false
  set vitesse-urgence-pompier 5
  
  ; 5) création des pompiers
  create-pompiers nombre-pompiers [
    set color cyan
    set shape "person"
    set size 3
    placer-troupe-dans-la-base self ; apparait dans la base
    set vitesse 3
    set eau-restante 0 ; réserve d'eau vide au départ
    set etat "en-patrouille" ; état de patrouille au départ
  ]
  
  ; 6) création des pyromanes
  create-pyromanes nombre-pyromanes [
    set color magenta
    set shape "person"
    set size 3
    placer-pyromane-hors-de-la-base self ; apparait hors de la base
    set vitesse 3
    set etat "en-pyromanie" ; état de pyromanie au départ
    set mon-garde nobody
  ]
  
  ; 7) création des gardes
  create-gardes nombre-gardes [
    set color yellow
    set shape "person"
    set size 3
    placer-troupe-dans-la-base self ; apparait dans la base
    set vitesse 2
    set etat "en-patrouille" ; état de patrouille au départ
  ]
  
  reset-ticks
end


to go
  ; définit l'état d'urgence
  set urgence-base? any? patches with [est-base? and en-feu? and durabilite-base > 0]
  ; comportement des agents
  go-pompiers
  go-pyromanes
  go-gardes
  
  ; mise à jour du terrain
  propagation-foret
  pousse-foret
  propagation-feu
  repousse-crame
  gestion-base
  
  ; gestion des odeurs
  gestion-odeur
  
  wait 0.1
  tick
end
]]></code>
  <widgets>
    <view x="265" wrappingAllowedX="true" y="5" frameRate="30.0" minPycor="-48" height="519" showTickCounter="true" patchSize="5.31" fontSize="10" wrappingAllowedY="true" width="519" tickCounterLabel="ticks" maxPycor="48" updateMode="0" maxPxcor="48" minPxcor="-48"></view>
    <slider x="5" step="1" y="5" max="200" width="250" display="nombre-pompiers" height="50" min="0" direction="Horizontal" default="81.0" variable="nombre-pompiers"></slider>
    <slider x="5" step="1" y="60" max="100" width="250" display="reserve-max-pompier" height="50" min="0" direction="Horizontal" default="100.0" variable="reserve-max-pompier"></slider>
    <slider x="5" step="1" y="125" max="20" width="250" display="nombre-gardes" height="50" min="0" direction="Horizontal" default="0.0" variable="nombre-gardes"></slider>
    <slider x="5" step="1" y="180" max="10" width="250" display="rayon-detection-gardes" height="50" min="0" direction="Horizontal" default="5.0" variable="rayon-detection-gardes"></slider>
    <slider x="5" step="1" y="245" max="20" width="250" display="nombre-pyromanes" height="50" min="0" direction="Horizontal" default="20.0" variable="nombre-pyromanes"></slider>
    <slider x="5" step="1" y="300" max="10" width="250" display="rayon-fuite-pyromanes" height="50" min="0" direction="Horizontal" default="5.0" variable="rayon-fuite-pyromanes"></slider>
    <slider x="795" step="1" y="10" max="100" width="250" display="pourcentage-foret" height="50" min="0" direction="Horizontal" default="17.0" variable="pourcentage-foret" units="%"></slider>
    <slider x="795" step="1" y="65" max="100" width="250" display="taille-max" height="50" min="0" direction="Horizontal" default="50.0" variable="taille-max"></slider>
    <slider x="795" step="1" y="120" max="30" width="250" display="temps-repousse-crame" height="50" min="0" direction="Horizontal" default="4.0" variable="temps-repousse-crame" units="s"></slider>
    <slider x="795" step="1" y="175" max="100" width="250" display="vitesse-propagation-foret" height="50" min="0" direction="Horizontal" default="10.0" variable="vitesse-propagation-foret"></slider>
    <slider x="795" step="0.5" y="245" max="50" width="250" display="vitesse-propagation-feu" height="50" min="0" direction="Horizontal" default="22.0" variable="vitesse-propagation-feu" units="%"></slider>
    <slider x="795" step="1" y="315" max="100" width="250" display="durabilite-base-max" height="50" min="1" direction="Horizontal" default="73.0" variable="durabilite-base-max"></slider>
    <button x="10" y="365" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="90">setup</button>
    <button x="140" y="365" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="85">go</button>
  </widgets>
