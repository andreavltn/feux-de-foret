        <setup></setup>
        <update>plot extinctions-tick</update>
      </pen>
    </plot>
    <slider x="535" step="2" y="15" max="30" width="250" display="taille-base" height="50" min="0" direction="Horizontal" default="14.0" variable="taille-base"></slider>
    <slider x="535" step="1" y="70" max="100" width="250" display="durabilite-base-max" height="50" min="1" direction="Horizontal" default="100.0" variable="durabilite-base-max"></slider>
    <monitor x="605" precision="17" y="125" height="60" fontSize="11" width="100" display="%Durabilité Base">round durabilite-totale-base</monitor>
    <slider x="585" step="1" y="240" max="100" width="250" display="pourcentage-foret" height="50" min="0" direction="Horizontal" default="42.0" variable="pourcentage-foret" units="%"></slider>
    <slider x="585" step="1" y="295" max="100" width="250" display="taille-max" height="50" min="0" direction="Horizontal" default="50.0" variable="taille-max"></slider>
    <slider x="585" step="1" y="350" max="100" width="250" display="vitesse-propagation-foret" height="50" min="0" direction="Horizontal" default="10.0" variable="vitesse-propagation-foret"></slider>
    <slider x="585" step="1" y="405" max="30" width="250" display="temps-repousse-crame" height="50" min="0" direction="Horizontal" default="6.0" variable="temps-repousse-crame" units="s"></slider>
    <slider x="585" step="0.5" y="460" max="50" width="250" display="vitesse-propagation-feu" height="50" min="0" direction="Horizontal" default="10.0" variable="vitesse-propagation-feu" units="%"></slider>
    <monitor x="650" precision="17" y="515" height="60" fontSize="11" width="100" display="%Forêt intacte">round pourcentage-foret-intacte</monitor>
    <switch x="75" y="335" height="33" on="false" variable="gardes-mort-feu" display="gardes-mort-feu" width="120" sizeVersion="0"></switch>
    <slider x="15" step="1" y="385" max="20" width="250" display="nombre-pyromanes" height="50" min="0" direction="Horizontal" default="10.0" variable="nombre-pyromanes"></slider>
    <slider x="15" step="1" y="440" max="10" width="250" display="rayon-fuite-pyromanes" height="50" min="0" direction="Horizontal" default="4.0" variable="rayon-fuite-pyromanes"></slider>
    <slider x="15" step="0.1" y="495" max="5" width="250" display="chance-declencher-feu" height="50" min="0" direction="Horizontal" default="2.5" variable="chance-declencher-feu" units="%"></slider>
    <switch x="65" y="550" height="33" on="false" variable="pyromanes-mort-feu" display="pyromanes-mort-feu" width="145" sizeVersion="0"></switch>
    <monitor x="435" precision="17" y="470" height="60" fontSize="11" width="105" display="Arrestations">arrestations-totales</monitor>
    <monitor x="435" precision="17" y="535" height="60" fontSize="11" width="105" display="Gardes vivants">count gardes</monitor>
    <monitor x="305" precision="17" y="470" height="60" fontSize="11" width="120" display="Pyromanes actifs">count pyromanes with [etat = "en-pyromanie"]</monitor>
    <monitor x="305" precision="17" y="535" height="60" fontSize="11" width="120" display="Pyromanes vivants">count pyromanes</monitor>
    <button x="440" y="625" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="85">go</button>
    <button x="330" y="625" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="90">setup</button>
  </widgets>
