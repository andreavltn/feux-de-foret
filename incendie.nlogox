<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="true">
  <code><![CDATA[globals [
  urgence-base? ; true si il y a urgence à la base (au moins un patch de base en train de bruler)
  arrestations-totales ; nombre total d'arrestations de pyromanes par les gardes (pour les statistiques)
  extinctions-totales ; nombre total d'extinctions de feu par les pompiers (pour les statistiques)
  extinctions-tick ; nombre d'extinctions de feu par les pompiers dans le tick en cours (pour les statistiques)
  total-foret ; nombre total de patches de forêt sur la carte (pour les statistiques)
  pourcentage-foret-intacte ; pourcentage de la forêt non brulée/cramée (pour les statistiques)
  durabilite-totale-base-max ; durabilité totale maximum de la base (pour les statistiques)
  durabilite-totale-base ; durabilité totale actuelle de la base (pour les statistiques) 
]

breed [ pompiers pompier]
breed [ gardes garde ]
breed [ pyromanes pyromane ]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

patches-own [
  est-foret? ; true si le patch est foret
  est-terre? ; true si le patch est terre
  est-base? ; true si le patch est la base des pompiers
  en-feu? ; true si le patch est en train de bruler
  est-crame? ; true si le patch est cramé
  est-eteint? ; true si le patch de forêt vient d'être éteint
  en-pousse? ; true si le patch de forêt est en train de pousser
  taille ; la taille actuelle du patch de forêt
  cpt-repousse ; compteur de temps actuel de repousse
  cpt-reprise-pousse ; compteur de temps pour la reprise de la pousse après avoir été éteint
  odeur-pyro ; la quantité d'odeur déposée par les pyromanes
  durabilite-base ; durabilité de la base face au feu ("points de vie du patch")
  etat-base ; état du patch de la base par rapport à sa durabilité ("indemne", "endommagé , "critique", "détruit")
]

pompiers-own [
  eau-restante ; la quantité d'eau restante du pompier
  etat; l'état en cours du pompier ("en-patrouille", "en-extinction", "en-ravitaillement")
  vitesse ; la vitesse du pompier
  a-eteindre ; le patch d'eau à éteindre
]

gardes-own [
  etat ; l'état en cours du garde ("en-patrouille", "en-poursuite", "en-suivi-odeur", "en-arrestation")
  vitesse ; la vitesse du garde
]

pyromanes-own [
  etat ; l'état en cours du pyromane ("en-fuite", "en-pyromanie", "en-capture")
  vitesse ; la vitesse du pyromane
  mon-garde ; le garde qui en-capture le pyroname
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; procédure qui initialise les variables au début du setup
to initialisation-variables-patches
  set est-foret? false
  set est-terre? false
  set est-base? false
  set en-feu? false
  set est-crame? false
  set est-eteint? false
  set en-pousse? false
  set taille 0
  set cpt-repousse 0
  set cpt-reprise-pousse 0
  set odeur-pyro 0
  set taille-base taille-base
  set durabilite-base 0
end


;;; procédure qui met à jour la couleur d'un patch en fonction de son état
to set-color-patches
  if est-terre? [set pcolor brown] ; marron pour la terre
  if est-foret? [set pcolor green - 2] ; vert foncé pour la forêt
  if est-base? [set pcolor blue] ; bleu pour la base
end


;;; procédure qui place une troupe (pompier/garde) aléatoirement dans la base
to placer-troupe-dans-la-base [la-troupe]
  let p one-of patches with [est-base?]  ; choisit aléatoirement un patch de la base (est-base? = true)
  ask la-troupe [ ; le place sur le patch choisi
    move-to p
  ]
end


;;; procédure qui place un pyromane aléatoirement hors de la base
to placer-pyromane-hors-de-la-base [le-pyromane]
  let p one-of patches with [not est-base?] ; choisit aléatoirement un patch hors de la base (est-base? = false)
  ask le-pyromane [ ; le place sur le patch choisi
    move-to p
  ]
end


;;; procédure qui fait agir les pompiers
to go-pompiers
  ask pompiers [
    
    ;; --------------- CHOIX DE L'ETAT ---------------
    
    ; si il n'a pas d'eau : passe en ravitaillement
    if eau-restante <= 0 [
      set etat "en-ravitaillement"
    ]
    
    ; on bloque toute la suite si on est déjà en ravitaillement
    if etat != "en-ravitaillement" [
      
      ; si il y a urgence à la base :
      if urgence-base?  [
        
        ; cherche le patch de base en feu non cramé le plus proche
        set a-eteindre min-one-of patches with [est-base? and en-feu? and not est-crame?] [distance myself]
        
        ; si il y en a un : passe en état d'urgence
        ifelse a-eteindre != nobody [
          set etat "en-urgence"
        ] [
          ; sinon passe en état de patrouille
          set etat "en-patrouille"
        ]
      ]
      
      ; si il n'est pas en urgence :
      if etat != "en-urgence" [
        
        ; cherche le patch de feu le plus proche à éteindre
        set a-eteindre min-one-of patches with [en-feu? and not est-crame?] [distance myself]
        
        ; si il y en a un : passe en état d'extinction
        ifelse a-eteindre != nobody [
          set etat "en-extinction"
        ] [
          ; sinon passe en état de patrouille
          set etat "en-patrouille"
        ]
      ]
    ]
    
    ;; --------------- COMPORTEMENT EN FONCTION DE L'ETAT ---------------
    
    ;; RAVITAILLEMENT
    if etat = "en-ravitaillement" [
      ravitaillement
    ]
    
    ;; PATROUILLE
    if etat = "en-patrouille" [
      rt random 50 - random 50 ; déplacement aléatoire
      fd vitesse
    ]
    
    ;; URGENCE / EXTINCTION
    if (etat = "en-urgence" or etat = "en-extinction") [
      
      ; vérification pour éviter les bugs
      ; si il a une cible, mais qu'elle à déjà cramé/déjà été éteinte
      if a-eteindre != nobody and [est-crame? or not en-feu?] of a-eteindre[
          
        ; alors on l'oublie
        set a-eteindre nobody
        
        ; et on repasse en état de patrouille
        set etat "en-patrouille"
      ]
      
      ; si on est maintenant sûrs que la cible existe
      if a-eteindre != nobody [
        
        ; calcule la distance à la cible
        let distance-feu distance a-eteindre
        
        ; si la distance est trop grande : s'en rapproche
        ifelse distance-feu > 2 [
          face a-eteindre
          fd vitesse
        ] [
          ; sinon l'éteint
          face a-eteindre
          eteindre
          set extinctions-totales extinctions-totales + 1
        ]
      ] 
    ]
  ]
end

;;; procédure qui fait se ravitailler le pompier
to ravitaillement
  
  ; cherche le patch de base non détruit le plus proche
  let base-utilisable min-one-of patches with [est-base? and durabilite-base > 0] [distance myself]
  
  ; si il existe
  if base-utilisable != nobody [
    
    ; si le pompier n'y est pas
    ifelse not [est-base? and durabilite-base > 0] of patch-here [
      
      ; s'y dirige
      face base-utilisable      
      fd vitesse
    ] [
      
      ; sinon il y est : se ravitaille
      set eau-restante reserve-max-pompier
      set etat "en-patrouille"
    ]
  ]
end


;;; procédure d'un pompier pour éteindre le feu
to eteindre
  
  ; nombre de patches de feu éteints pendant le tick
  let nb-extinctions 0 
  
  ; pour tous les patches à 2 de distance en feu
  ask patches in-radius 2 with [en-feu?] [
    set en-feu? false
    set est-eteint? true ; passe en état "éteint"
    set pcolor white ; devient blanc temporairement pour simuler le jet d'eau
    set cpt-reprise-pousse 5 ; démarre le compteur de repousse de 5 ticks 
    set nb-extinctions nb-extinctions + 1 ; incrémente le nombre de patches éteints
    set extinctions-tick extinctions-tick + 1
  ]
  
  ; décrémente l'eau restante 
  set eau-restante eau-restante - nb-extinctions 
end


;;; procédure qui fait agir les pyromanes
to go-pyromanes
  ask pyromanes [
    
    ;; --------------- CHOIX DE L'ETAT ---------------
    
    ; si le pyromane est capturé : on ne change pas l'état
    if etat != "en-capture" [
      
      ; détecte le garde le plus proche dans son rayon de détection
      let menace min-one-of gardes in-radius rayon-fuite-pyromanes [distance myself]
      
      ; si il y a une menace : état de fuite
      ifelse menace != nobody [
        set etat "en-fuite"
      ] [
        ; sinon : état de pyromanie
        set etat "en-pyromanie"
      ]
    ]
    
    ;; --------------- COMPORTEMENT EN FONCTION DE L'ETAT ---------------
    
    ;; CAPTURE
    if etat = "en-capture" [
      
      ; suit le garde qui l'a capturé
      if mon-garde != nobody [
        move-to mon-garde
        set color orange
      ]
      
      ; si il est arrivé à la base, il disparait
      if [est-base?] of patch-here [
        set arrestations-totales arrestations-totales + 1
        die
      ]
    ]
    
    ;; FUITE ET PYROMANIE
    if etat = "en-fuite" or etat = "en-pyromanie" [
      
      ; si il est affecté par le feu
      if pyromanes-mort-feu [
        
        ; cherche un patch de feu dans un rayon de 5
        let danger1 min-one-of patches in-radius 5 with [en-feu?] [distance myself]
        
        ; si il y en a un, part à l'opposé
        if danger1 != nobody [
          face danger1
          rt 180
          fd vitesse
        ]
      ]
      
      ; et dans tous les cas, cherche un patch de base dans un rayon de 5
      let danger2 min-one-of patches in-radius 5 with [est-base?] [distance myself]
      
      ; si il y en a un, le fuit
        if danger2 != nobody [
          face danger2
          rt 180
          fd vitesse
        ]
      
      ; dépose de l'odeur
      ask patch-here [
        set odeur-pyro 100
      ]
    ]
    
    ;; FUITE
    if etat = "en-fuite" [
      
      ; cherche un garde dans son rayon de fuite
      let menace min-one-of gardes in-radius rayon-fuite-pyromanes [distance myself]
      
      ; si il y en a un, le fuit
      if menace != nobody [
        face menace
        rt 180
        fd vitesse
      ]
    ]
    
    ;; PYROMANIE
    if etat = "en-pyromanie" [
      
      ; déplacement aléatoire
      rt random 50 - random 50
      fd vitesse
      
      ; met le feu avec une certaine chance au patch devant lui
      ask patch-ahead 1 [  
        
        ; si c'est un patch de forêt de taille max, non cramé et pas déjà en feu
        if (est-foret? and not en-feu? and not est-crame? and not en-pousse?) [
          
          ; chance de déclencher un feu
          if random 100 < chance-declencher-feu [
            set en-feu? true
            set en-pousse? false
          ]
        ]
      ]
    ]
    
    ; si l'option est activée, il meurt au contact du feu
    if pyromanes-mort-feu [mort-feu]
  ]
end

;;; procédure qui fait agir les gardes
to go-gardes
  ask gardes [
    
    ;; --------------- CHOIX DE L'ETAT ---------------
    
    ; cherche un pyromane proche
    let pyromane-proche one-of pyromanes in-radius 1 with [mon-garde = nobody]
    
    ; si il y en a un : passe en état d'arrestation
    if pyromane-proche != nobody [
      
      set etat "en-arrestation"
      
      ; et le pyromane passe en état de capture + le garde devient son "mon-garde"
      ask pyromane-proche [
        set etat "en-capture" 
        set mon-garde myself 
      ]
    ]
    
    ; si le garde n'est pas en état d'arrestation
    if etat != "en-arrestation" [
      
      ; cherche le pyromane le plus proche dans son rayon de détection
      let cible min-one-of pyromanes with [mon-garde = nobody] in-radius rayon-detection-gardes [distance myself]
      
      ; si il y en a un : passe en état de poursuite
      ifelse cible != nobody [
        set etat "en-poursuite"
      ] [
        ; sinon recherche l'odeur la plus forte
        let trace max-one-of neighbors [odeur-pyro]
        let seuil-detection 1.0
        
        ; si il y a une odeur assez forte : passe en état de suivi d'odeur
        ifelse [odeur-pyro] of trace > seuil-detection [
          set etat "en-suivi-odeur"
        ] [
          ; sinon : passe en état de patrouille
          set etat "en-patrouille"
        ]
      ]
    ]
    
    ;; --------------- COMPORTEMENT EN FONCTION DE L'ETAT ---------------
    
    ;; ARRESTATION
    if etat = "en-arrestation" [
      
      ; cherche le patch de base le plus proche
      let base min-one-of patches with [est-base?] [distance myself]
      
      ; si il n'y est pas : s'y dirige
      ifelse not [est-base?] of patch-here [
        face base
        fd vitesse
      ] [
        ; sinon il y est : retour en patrouille
        set etat "en-patrouille"
      ]
    ]
    
    ;; POURSUITE ET SUIVI D'ODEUR ET PATROUILLE (si il est affecté par le feu)
    if etat = "en-poursuite" or etat = "en-suivi-odeur" or etat = "en-patrouille" and gardes-mort-feu [
      
      ; cherche un patch de feu dans un rayon de 5
      let danger min-one-of patches in-radius 5 with [en-feu?] [distance myself]
      
      ; si il y en a un : le fuit
      if danger != nobody [
        face danger
        rt 180
        fd vitesse
      ]
    ]
    
    ;; POURSUITE
    if etat = "en-poursuite" [
      
      ; cherche le pyromane le plus proche
      let cible min-one-of pyromanes with [mon-garde = nobody] in-radius rayon-detection-gardes [distance myself]
      
      ; si il y en à un : le poursuit
      if cible != nobody [
        face cible 
        fd vitesse
      ]
    ]
    
    ;; SUIVI D'ODEUR
    if etat = "en-suivi-odeur" [
      
      ; cherche l'odeur la plus forte
      let trace max-one-of neighbors [odeur-pyro]
      
      ; si il y en a une : la suit
      if trace != nobody [
        face trace
        fd vitesse
      ]
    ]
    
    ;; PATROUILLE
    if etat = "en-patrouille" [
      
      ; déplacements aléatoires
      rt random 50 - random 50
      fd vitesse
    ]
    
    ; si l'option est activée, il meurt au contact du feu
    if gardes-mort-feu [mort-feu]
  ]
end


;;; procédure de mort en contact du feu 
to mort-feu
  
  ; si le patch sur lequel il se trouve est en feu : mort
  if [en-feu?] of patch-here [die] 
end


;;; procédure qui fait se propager la forêt sur la terre
to propagation-foret
  
  ; pour tous les patches de forêt ni en pousse, ni cramés, ni bases
  ask patches with [est-foret? and not est-crame? and not en-pousse? and not est-base?] [ 
    
    ; pour tous leurs voisins qui sont terre
    ask neighbors with [est-terre?] [ 
      
      ; chance de se propager dessus
      if random 100 < vitesse-propagation-foret [
        set est-terre? false 
        set est-foret? true
        set en-pousse? true
        set taille 0
        set pcolor (green + 2) ; couleur vert foncé
      ]
    ]
  ]
end


;;; procédure qui fait grandir les patches de forêt en état de pousse 
to pousse-foret
  
  ; pour tous les patches de forêt en pousse
  ask patches with [est-foret? and en-pousse?] [
    
    ; incrémente la taille
    set taille taille + 1 
    
    ; dégradé de couleur du vert clair au foncé en fonction de la taille
    let t (taille / taille-max) 
    set pcolor green - (t * 2)
    
    ; si la taille max est atteinte
    if taille >= taille-max [
      set en-pousse? false ; arrêt de la pousse
      set taille taille-max ; remet la taille au maximum en cas de dépassement
      set pcolor (green - 2) ; couleur forêt 
    ]
  ]
end


;;; procédure qui fait repousser les patches de forêt cramés, et reprend la pousse de ceux éteints
to gestion-crame-eteint
  
  ; pour tous les patches cramés
  ask patches with [est-crame?] [
    set cpt-repousse cpt-repousse - 1 ; décrémente le compteur de repousse
    
    ; si le compteur est terminé : le patch redevient forêt en pousse de taille 0
      if (cpt-repousse <= 0) [
        set est-crame? false
        set est-foret? true
        set en-pousse? true
        set taille 0
      ]
  ]
  
  ; pour tous les patches éteints
  ask patches with [est-eteint?] [
    set cpt-reprise-pousse cpt-reprise-pousse - 1 ; décrémente le compteur de reprise de la pousse
    
    ; si le compteur est terminé : le patch reprend sa pousse (et donc sa couleur)
      if (cpt-reprise-pousse <= 0) [
        set est-eteint? false
        set en-pousse? true
      ]
    ]
end


;;; procédure qui fait se propager le feu
to propagation-feu
  
  ; pour tous les patches en feu non cramés 
  ask patches with [en-feu? and not est-crame?] [
    
    ; si ils font partie de la base
    ifelse est-base? [
      set durabilite-base durabilite-base - 1 ; décrémente la durabilité
      
      ; si elle atteint le min
      if durabilite-base < 0 [
        set durabilite-base 0 ; on la remet à 0 (dépassement de seuil)
      ]
    ] [ 
      
      ; sinon c'est forêt, réduction progressive de la taille
      set taille taille - 0.5
    
      ; si la taille min est atteinte, le patch est cramé
      if taille <= 0 [ 
        set taille 0 ; remet la taille à 0 (dépassement de seuil)
        set en-feu? false 
        set est-crame? true
        set pcolor black
        set cpt-repousse temps-repousse-crame
      ]
    ]
    
    ; propagation aux voisins
    ask neighbors with [(est-foret? or est-base?) and not en-feu? and not est-crame? and not en-pousse?] [ 
      
      ; chance de se propager dessus
      if random 100 < vitesse-propagation-feu [
        set en-pousse? false 
        set en-feu? true
        set pcolor red ; le patch devient rouge  
      ]
    ]
    
    ; si c'est un patch de forêt en feu
    if en-feu? and not est-base? [ 
      
      ; dégradé de couleur : plus foncé = plus brulé
      let t 1 - (taille / taille-max) 
      set pcolor red - (t * 4) 
    ]
  ]
end


;;; procédure qui met à jour l'état de la base
to gestion-base
  
  ; pour tous les patches de la base
  ask patches with [est-base?] [
    
    ; calcul du pourcentage de durabilité restant
    let pourcentage-base durabilite-base / durabilite-base-max
    
    ; si 0% : détruit (noir)
    ifelse durabilite-base <= 0 [
      set etat-base "détruit"
      set pcolor black
    ] [
      
      ; sinon si entre 0% et 33% : critique (rouge)
      ifelse pourcentage-base <= 0.33 [
        set etat-base "critique"
        set pcolor red
      ] [
        
        ; sinon si entre 33% et 66%: endommagé (violet)
        ifelse pourcentage-base <= 0.66 [
          set etat-base "endommagé"
          set pcolor violet
        ] [
          
          ; sinon si entre 66% et 100% : indemne (bleu)
          set etat-base "indemne"
          set pcolor blue
        ]
      ]
    ]
  ]
end


;;; procédure qui diffuse et fait s'évaporer l'odeur des pyromanes 
to gestion-odeur
  
  ; diffusion de l'odeur sur les patches voisins
  diffuse odeur-pyro 0.2
  
  ; évaporation de l'odeur progressive 
  ask patches [
    set odeur-pyro odeur-pyro - 5 
  ]
end


;;; procédure qui définit si il y a un état d'urgence ou non (pour les pompiers)
to gestion-urgence
  
  ; si un patche de la base non détruit est en feu : état d'urgence
  set urgence-base? any? patches with [est-base? and en-feu? and durabilite-base > 0]
end


;;; procédure qui calcule la surface de la forêt en pourcentage
to calcul-pourcentage-foret
  let patches-sains count patches with [est-foret? and not en-feu? and not est-crame? and not est-eteint? and not en-pousse?]
  set pourcentage-foret-intacte (100 * (patches-sains / total-foret))
end


;;; procédure qui calcule la durabilité restante totale de la base
to calcul-pourcentage-durabilite
  let durabilite-actuelle sum [durabilite-base] of patches with [est-base?]
  set durabilite-totale-base (100 * (durabilite-actuelle / durabilite-totale-base-max))
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all

  ask patches [
    
    ; 1) initialisation des variables des patches
    initialisation-variables-patches 
 
    ; 2) création de la base (de taille "taille-base")
    if (pxcor >= (0 - taille-base / 2) and pxcor < (0 + taille-base / 2) and pycor >= (0 - taille-base / 2) and pycor < (0 + taille-base / 2)) [
      set est-base? true 
      set etat-base "indemne" ; état indemne
      set durabilite-base durabilite-base-max ; durabilité max
    ]
    
    ; 3) pourcentage de forêt/terre sur tout le reste
    if not est-base? [
      ifelse random 100 < pourcentage-foret [
        set est-foret? true
        set taille taille-max ; taille max pour la forêt
      ] [
        set est-terre? true
      ]
    ]
   
    ; 4) mise à jour de la couleur des patches en fonction de leur type
    set-color-patches
  ]
  
  ; 5) création des pompiers
  create-pompiers nombre-pompiers [
    set color cyan
    set shape "person"
    set size 3
    placer-troupe-dans-la-base self ; apparait dans la base
    set vitesse 3
    set eau-restante 0 ; réserve d'eau vide au départ
    set etat "en-patrouille" ; état de patrouille au départ
    set a-eteindre nobody ; aucun patch à éteindre au départ
  ]
  
  ; 6) création des pyromanes
  create-pyromanes nombre-pyromanes [
    set color magenta
    set shape "person"
    set size 3
    placer-pyromane-hors-de-la-base self ; apparait hors de la base
    set vitesse 3
    set etat "en-pyromanie" ; état de pyromanie au départ
    set mon-garde nobody ; pas de garde qui le capture
  ]
  
  ; 7) création des gardes
  create-gardes nombre-gardes [
    set color yellow
    set shape "person"
    set size 3
    placer-troupe-dans-la-base self ; apparait dans la base
    set vitesse 2 ; vitesse un peu plus lente que les autres
    set etat "en-patrouille" ; état de patrouille au départ
  ]
  
  ; 8) initialisation des variables pour les statistiques
  
  set urgence-base? false ; réinitialisation de l'état d'urgence
  set arrestations-totales 0 ; compteur d'arrestations
  set extinctions-totales 0 ; compteur de patches éteint par les pompiers
  
  ; compteur du nombre total de patches de forêt
  set total-foret count patches with [not est-base?] 
  
  ; compteur de la durabilité maximum de la base
  let nombre-patches-base count patches with [est-base?] 
  set durabilite-totale-base-max (nombre-patches-base * durabilite-base-max)
  
  reset-ticks
end


to go
  
  ; réinitialisation du nombre d'extinctions par tick (pour les statistiques)
  set extinctions-tick 0 
  
  ; comportement des agents
  go-pompiers
  go-pyromanes
  go-gardes
  
  ; mise à jour du terrain
  propagation-foret
  pousse-foret
  propagation-feu
  gestion-crame-eteint
  gestion-base
 
  ; gestion des odeurs
  gestion-odeur
  
  ; gestion de l'état d'urgence
  gestion-urgence
  
  ; calculs pour les statistiques
  calcul-pourcentage-foret
  calcul-pourcentage-durabilite
  
  tick
end
]]></code>
  <widgets>
    <view x="875" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-48" height="749" showTickCounter="true" patchSize="7.6804124" fontSize="10" wrappingAllowedY="true" width="749" tickCounterLabel="ticks" maxPycor="48" updateMode="0" maxPxcor="48" minPxcor="-48"></view>
    <slider x="20" step="1" y="225" max="20" width="250" display="nombre-gardes" height="50" min="0" direction="Horizontal" default="16.0" variable="nombre-gardes"></slider>
    <slider x="20" step="1" y="280" max="10" width="250" display="rayon-detection-gardes" height="50" min="0" direction="Horizontal" default="4.0" variable="rayon-detection-gardes"></slider>
    <plot x="285" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Nombre d'agents" y="245" xMin="0.0" height="210" legend="false" xMax="10.0" yMin="0.0" width="275" xAxis="Temps" display="Gardes vs Pyronames">
      <setup></setup>
      <update></update>
      <pen interval="5.0" mode="0" display="Pyromanes Actifs" color="-2674135" legend="true">
        <setup></setup>
        <update>plot count pyromanes with [etat = "en-pyromanie"]</update>
      </pen>
      <pen interval="5.0" mode="0" display="Arrestations" color="-13345367" legend="true">
        <setup></setup>
        <update>plot arrestations-totales</update>
      </pen>
    </plot>
    <slider x="20" step="1" y="70" max="300" width="250" display="reserve-max-pompier" height="50" min="0" direction="Horizontal" default="200.0" variable="reserve-max-pompier"></slider>
    <slider x="20" step="1" y="15" max="200" width="250" display="nombre-pompiers" height="50" min="0" direction="Horizontal" default="150.0" variable="nombre-pompiers"></slider>
    <monitor x="90" precision="17" y="125" height="60" fontSize="11" width="100" display="Extinctions">extinctions-totales</monitor>
    <plot x="280" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Extinctions/tick" y="15" xMin="0.0" height="170" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="Temps" display="Efficacité des Pompiers">
      <setup></setup>
      <update></update>
